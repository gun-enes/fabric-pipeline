{
	"name": "pl_delete_failed_tables_blob",
	"properties": {
		"activities": [
			{
				"name": "For each failed table blobs to delete",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.filesToDelete",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Delete blob",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.05:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "BackupContainerCETAS",
									"type": "DatasetReference",
									"parameters": {
										"cw_folderName": {
											"value": "@concat('/backup/', item().filename)",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"filesToDelete": {
				"type": "array"
			}
		},
		"annotations": []
	}
}