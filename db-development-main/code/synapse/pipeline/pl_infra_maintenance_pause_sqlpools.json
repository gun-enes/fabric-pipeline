{
	"name": "pl_infra_maintenance_pause_sqlpools",
	"properties": {
		"description": "this pipeline will start-stop triggers in workspace during maintenance",
		"activities": [
			{
				"name": "ForEach sqlpool in response",
				"description": "Iterates over list of sqlpool response",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Save SQLPool State",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('sql_pools_list')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If Status Online",
							"description": "checks if the status is online or not",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().properties.status,'Online' )",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Pause sql pool",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_control_sql_pool",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"workspace_name": {
													"value": "@split(item().id,'/')[8]",
													"type": "Expression"
												},
												"sqlPool_name": {
													"value": "@item().name",
													"type": "Expression"
												},
												"resourceGroup": {
													"value": "@split(item().id,'/')[4]",
													"type": "Expression"
												},
												"subscriptionId": {
													"value": "@split(item().id,'/')[2]",
													"type": "Expression"
												},
												"target_state": "paused"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "activity-get-all-sqlpools-workspace",
				"description": "this activity will list all the sqlpools in workspace",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"disableCertValidation": false,
					"url": {
						"value": "@concat('https://',pipeline().parameters.workspace_name,'.dev.azuresynapse.net/sqlPools?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"properties": {
							"runtimeState": "stopped"
						}
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			},
			{
				"name": "Set sqlpools response",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "activity-get-all-sqlpools-workspace",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "sql_pools_list",
					"value": {
						"value": "@activity('activity-get-all-sqlpools-workspace').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Save SQLPool State",
				"description": "This activity saves the state of SQL Pools in the management workspace",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set sqlpools response",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-version": "2017-11-09",
						"x-ms-blob-type": "BlockBlob"
					},
					"url": {
						"value": "@concat('https://',pipeline().parameters.storage_account,'.blob.core.windows.net/sac-mgmt-main/sqlPoolStateFiles/',pipeline().parameters.workspace_name,'_sqlPools.json')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "@variables('sql_pools_list')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			}
		],
		"parameters": {
			"storage_account": {
				"type": "string",
				"defaultValue": "stspf0091devwks"
			},
			"workspace_name": {
				"type": "String",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			}
		},
		"variables": {
			"sql_pools_list": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "Maintenance_Start_Activities"
		},
		"annotations": [],
		"lastPublishTime": "2025-04-04T11:49:08Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}