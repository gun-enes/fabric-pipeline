{
	"name": "pl_infra_maintenance_start_triggers",
	"properties": {
		"description": "this pipeline will start-stop triggers in workspace during maintenance",
		"activities": [
			{
				"name": "ForEach trigger in response",
				"description": "Iterates over list of tigger responce",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read Triggers state file",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read Triggers state file').output.value",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "If runtimeState started",
							"description": "checks if runtimeState state is started or not",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().properties.runtimeState,'Started')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "activity-start-trigger",
										"type": "WebActivity",
										"dependsOn": [],
										"policy": {
											"timeout": "0.00:10:00",
											"retry": 3,
											"retryIntervalInSeconds": 300,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"method": "POST",
											"url": {
												"value": "@concat('https://', pipeline().parameters.workspace_name,\n'.dev.azuresynapse.net/triggers/',item().name,\n'/start?api-version=2020-12-01')",
												"type": "Expression"
											},
											"connectVia": {
												"referenceName": "VNetEnabledIntegrationRuntime",
												"type": "IntegrationRuntimeReference"
											},
											"body": "{\"\"}",
											"authentication": {
												"type": "MSI",
												"resource": "https://dev.azuresynapse.net"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Read Triggers state file",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "triggerStateFile",
						"type": "DatasetReference",
						"parameters": {
							"workspace_name": {
								"value": "@pipeline().parameters.workspace_name",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "No Trigger State File - Skip",
				"description": "Trigger state file does not exist for this workspace (no stop was ever recorded for it) - nothing to restart, treat as a no-op instead of failing the pipeline",
				"type": "Wait",
				"dependsOn": [
					{
						"activity": "Read Triggers state file",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"waitTimeInSeconds": 1
				}
			}
		],
		"parameters": {
			"workspace_name": {
				"type": "string",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			},
			"storage_account": {
				"type": "string",
				"defaultValue": "stspf0091devwks"
			}
		},
		"folder": {
			"name": "Maintenance_End_Activities"
		},
		"annotations": [],
		"lastPublishTime": "2024-05-21T06:15:46Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}
