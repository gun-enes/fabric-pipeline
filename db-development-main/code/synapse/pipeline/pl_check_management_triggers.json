{
	"name": "pl_check_management_triggers",
	"properties": {
		"activities": [
			{
				"name": "Stop non-mgmt triggers",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(pipeline().DataFactory, pipeline().parameters.workspace_name))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute Stop Triggers Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_infra_maintenance_stop_triggers",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"workspace_name": {
										"value": "@pipeline().parameters.workspace_name",
										"type": "Expression"
									},
									"storage_account": {
										"value": "@pipeline().parameters.storage_account",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"workspace_name": {
				"type": "string",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			},
			"storage_account": {
				"type": "string",
				"defaultValue": "stspf0091devwks"
			}
		},
		"folder": {
			"name": "Maintenance_Start_Activities"
		},
		"annotations": []
	}
}