{
	"name": "pl_infra_maintenance_stop_triggers",
	"properties": {
		"description": "this pipeline will start-stop triggers in workspace during maintenance",
		"activities": [
			{
				"name": "ForEach trigger in response",
				"description": "Iterates over list of tigger responce",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Save Triggers State",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('triggers_list')",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "If runtimeState started and non maintenance trigger",
							"description": "checks if runtimeState state is started or not",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().properties.runtimeState,'Started')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "activity-stop-trigger",
										"type": "WebActivity",
										"dependsOn": [],
										"policy": {
											"timeout": "0.00:10:00",
											"retry": 3,
											"retryIntervalInSeconds": 300,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"method": "POST",
											"url": {
												"value": "@concat('https://', pipeline().parameters.workspace_name,\n'.dev.azuresynapse.net/triggers/',item().name,\n'/stop?api-version=2020-12-01')",
												"type": "Expression"
											},
											"connectVia": {
												"referenceName": "VNetEnabledIntegrationRuntime",
												"type": "IntegrationRuntimeReference"
											},
											"body": "{\"\"}",
											"authentication": {
												"type": "MSI",
												"resource": "https://dev.azuresynapse.net"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "activity-get-all-trigger-workspace",
				"description": "this activity will list all the triggers in workspace",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://', pipeline().parameters.workspace_name,\n'.dev.azuresynapse.net/triggers?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"properties": {
							"runtimeState": "stopped"
						}
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net"
					}
				}
			},
			{
				"name": "Set triggers response",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "activity-get-all-trigger-workspace",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "triggers_list",
					"value": {
						"value": "@activity('activity-get-all-trigger-workspace').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Save Triggers State",
				"description": "This activity saves the state of Triggers in the management workspace",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set triggers response",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"x-ms-version": "2017-11-09",
						"x-ms-blob-type": "BlockBlob"
					},
					"url": {
						"value": "@concat('https://',pipeline().parameters.storage_account,'.blob.core.windows.net/sac-mgmt-main/triggerStateFiles/',pipeline().parameters.workspace_name,'_triggers.json')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "@variables('triggers_list')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://storage.azure.com/"
					}
				}
			}
		],
		"parameters": {
			"workspace_name": {
				"type": "string",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			},
			"storage_account": {
				"type": "string",
				"defaultValue": "stspf0091devwks"
			}
		},
		"variables": {
			"triggers_list": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "Maintenance_Start_Activities"
		},
		"annotations": [],
		"lastPublishTime": "2024-05-22T04:15:21Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}