{
	"name": "pl_check_active_pipelines",
	"properties": {
		"activities": [
			{
				"name": "Until the Pipeline Finishes",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('pipelinesInProgress'),0)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Set count of InProgress Pipelines",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "QueryPipelines",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelinesInProgress",
								"value": {
									"value": "@length(activity('QueryPipelines').output.value)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "QueryPipelines",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": {
									"value": "@concat('https://',pipeline().parameters.workspace_name,'.dev.azuresynapse.net/queryPipelineRuns?api-version=2020-12-01')",
									"type": "Expression"
								},
								"connectVia": {
									"referenceName": "VNetEnabledIntegrationRuntime",
									"type": "IntegrationRuntimeReference"
								},
								"body": {
									"value": "{\n  \"lastUpdatedAfter\": \"@{formatDateTime(addHours(utcnow(), -24), 'yyyy-MM-ddTHH:mm:ssZ')}\",\n  \"lastUpdatedBefore\": \"@{formatDateTime(utcnow(), 'yyyy-MM-ddTHH:mm:ssZ')}\",\n  \"filters\": [\n    {\n      \"operand\": \"PipelineName\",\n      \"operator\": \"NotIn\",\n      \"values\": [\n        \"pl_root_infra_maintenance_start\",\"pl_infra_maintenance_stop_triggers\",\"pl_infra_maintenance_pause_sqlpools\",\"pl_check_active_pipelines\",\n          \"pl_check_opt_out_mode\"\n      ]\n    },\n        {\n      \"operand\": \"Status\",\n      \"operator\": \"In\",\n      \"values\": [\n        \"InProgress\",\"Queued\"\n      ]\n    }\n  ]\n}",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://dev.azuresynapse.net/"
								}
							}
						}
					],
					"timeout": "0.04:00:00"
				}
			}
		],
		"parameters": {
			"workspace_name": {
				"type": "string",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			}
		},
		"variables": {
			"pipelinesInProgress": {
				"type": "Integer"
			}
		},
		"folder": {
			"name": "Maintenance_Start_Activities"
		},
		"annotations": [],
		"lastPublishTime": "2024-07-29T10:40:38Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}