{
	"name": "pl_root_infra_restore_db_pitr",
	"properties": {
		"activities": [
			{
				"name": "Lookup Backup Master Table",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Decision-maker for backup restart",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:15:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    [table_schema],\n    [table_name],\n    [filename],\n    [dir_name],\n    [tab_rename]\nFROM [mgmt_xtinfra].[infra_dr_backup_master] WHERE status <> 'RESTORE-SUCCESS'",
						"queryTimeout": "00:30:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DR_BACKUP_LINK",
						"type": "DatasetReference",
						"parameters": {
							"dbName": {
								"value": "@pipeline().parameters.SourceDB",
								"type": "Expression"
							},
							"cw_schema": {
								"value": "@pipeline().parameters.SchemaName",
								"type": "Expression"
							},
							"cw_table": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							},
							"WorkspaceName": {
								"value": "@pipeline().parameters.WorkspaceName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Restore PITR For Each Table",
				"description": "Restore PITR For Each Table Defined in infra_dr_backup_master",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Backup Master Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Backup Master Table').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 10,
					"activities": [
						{
							"name": "Create Table in Target",
							"description": "Create Table in TargetDB based on table definition in SourceDB ",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Generate Table Definition String",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:20:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "DedicatedForBackup",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.TargetDB",
										"type": "Expression"
									},
									"WorkspaceName": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									}
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "table_definition",
												"type": "String",
												"value": {
													"value": "@{activity('Generate Table Definition String').output.resultSets[0].rows[0].table_definition}",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": {
											"value": "EXEC [sp_executesql] @table_definition;",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Generate Table Definition String",
							"description": "Generate Table Definition String in SourceDB",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Execute pl_dr_backup_table",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:20:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "DedicatedForBackup",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.SourceDB",
										"type": "Expression"
									},
									"WorkspaceName": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									}
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "schema_name",
												"type": "String",
												"value": {
													"value": "@item().table_schema",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "table_name",
												"type": "String",
												"value": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "table_rename",
												"type": "String",
												"value": {
													"value": "@item().tab_rename",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": {
											"value": "DECLARE @table_definition NVARCHAR(MAX);\nEXEC [mgmt_xtinfra].[sp_infra_generate_table_definition] @schema_name, @table_name, @table_rename, @table_definition OUTPUT;\nSELECT @table_definition AS [table_definition]\n\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Execute pl_dr_backup_table",
							"description": "Execute single table backup process in SourceDB",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_dr_backup_table",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"workspace_name": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									},
									"table_schema": {
										"value": "@item().table_schema",
										"type": "Expression"
									},
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									},
									"filename": {
										"value": "@item().filename",
										"type": "Expression"
									},
									"source_db": {
										"value": "@pipeline().parameters.SourceDB",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute pl_dr_restore_table",
							"description": "Execute single table restore process in TargetDB",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Create Table in Target",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_dr_restore_table",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"workspace_name": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									},
									"table_schema": {
										"value": "@item().table_schema",
										"type": "Expression"
									},
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									},
									"filename": {
										"value": "@item().filename",
										"type": "Expression"
									},
									"source_db": {
										"value": "@pipeline().parameters.SourceDB",
										"type": "Expression"
									},
									"target_db": {
										"value": "@pipeline().parameters.TargetDB",
										"type": "Expression"
									},
									"table_rename": {
										"value": "@item().tab_rename",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Target Table Hash",
				"description": "For validation calculate and write BINARY CHECKSUM Hashing of each restored table in TargetDB",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Restore PITR For Each Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:30:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[mgmt_xtinfra].[sp_infra_dr_backup_checksum]",
					"storedProcedureParameters": {
						"OPS_TYPE": {
							"value": "TARGET_PITR",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DedicatedForBackup",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": {
							"value": "@pipeline().parameters.TargetDB",
							"type": "Expression"
						},
						"WorkspaceName": {
							"value": "@pipeline().parameters.WorkspaceName",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "DR Backup Validation",
				"description": "Compare source and target hash for all tables",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Target Table Hash",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:20:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[mgmt_xtinfra].[sp_infra_dr_backup_validation]"
				},
				"linkedServiceName": {
					"referenceName": "DedicatedForBackup",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": {
							"value": "@pipeline().parameters.TargetDB",
							"type": "Expression"
						},
						"WorkspaceName": {
							"value": "@pipeline().parameters.WorkspaceName",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Drop External Tables in Target",
				"description": "Drop temporarily created external tables during restore",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "DR Backup Validation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[mgmt_xtinfra].[sp_infra_drop_dr_backup_exttables]",
					"storedProcedureParameters": {
						"OPS_TYPE": {
							"value": "PITR",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DedicatedForBackup",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": {
							"value": "@pipeline().parameters.TargetDB",
							"type": "Expression"
						},
						"WorkspaceName": {
							"value": "@pipeline().parameters.WorkspaceName",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Decision-maker for backup restart",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LookupOldRestoreSession",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(int(activity('LookupOldRestoreSession').output.value[0].record_count),0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Initialize with Backup Runner for PITR",
							"description": "Initialize with Backup Runner for PITR\nBased on RestoreType, SchemaName, TableName inputs",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:30:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[mgmt_xtinfra].[sp_infra_backup_runner]",
								"storedProcedureParameters": {
									"dir_name": {
										"value": {
											"value": "@pipeline().parameters.RestoreName",
											"type": "Expression"
										},
										"type": "String"
									},
									"restore_type": {
										"value": {
											"value": "@pipeline().parameters.RestoreType",
											"type": "Expression"
										},
										"type": "String"
									},
									"schema_name": {
										"value": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										},
										"type": "String"
									},
									"table_name": {
										"value": {
											"value": "@pipeline().parameters.TableName",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "DedicatedForBackup",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.SourceDB",
										"type": "Expression"
									},
									"WorkspaceName": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Source Table Hash",
							"description": "For validation calculate and write BINARY CHECKSUM Hashing of each table in SourceDB",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Initialize with Backup Runner for PITR",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.02:30:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[mgmt_xtinfra].[sp_infra_dr_backup_checksum]",
								"storedProcedureParameters": {
									"OPS_TYPE": {
										"value": "SOURCE",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "DedicatedForBackup",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.SourceDB",
										"type": "Expression"
									},
									"WorkspaceName": {
										"value": "@pipeline().parameters.WorkspaceName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "LookupOldRestoreSession",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:15:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat(\n'SELECT COUNT(*) AS record_count \nFROM [mgmt_xtinfra].[infra_dr_backup_master] \nWHERE [dir_name] = ''',\npipeline().parameters.RestoreName,\n''' AND [status] <> ''RESTORE-SUCCESS'''\n)",
							"type": "Expression"
						},
						"queryTimeout": "00:30:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DR_BACKUP_LINK",
						"type": "DatasetReference",
						"parameters": {
							"dbName": {
								"value": "@pipeline().parameters.SourceDB",
								"type": "Expression"
							},
							"cw_schema": {
								"value": "@pipeline().parameters.SchemaName",
								"type": "Expression"
							},
							"cw_table": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							},
							"WorkspaceName": {
								"value": "@pipeline().parameters.WorkspaceName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Drop External Tables in Source",
				"description": "Drop temporarily created external tables during restore",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Drop External Tables in Target",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[mgmt_xtinfra].[sp_infra_drop_dr_backup_exttables]",
					"storedProcedureParameters": {
						"OPS_TYPE": {
							"value": "PITR",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DedicatedForBackup",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": {
							"value": "@pipeline().parameters.SourceDB",
							"type": "Expression"
						},
						"WorkspaceName": {
							"value": "@pipeline().parameters.WorkspaceName",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"SourceDB": {
				"type": "string"
			},
			"TargetDB": {
				"type": "string"
			},
			"WorkspaceName": {
				"type": "string"
			},
			"SchemaName": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			},
			"RestoreType": {
				"type": "string"
			},
			"RestoreName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}