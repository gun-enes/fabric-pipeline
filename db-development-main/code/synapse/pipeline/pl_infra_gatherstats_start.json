{
	"name": "pl_infra_gatherstats_start",
	"properties": {
		"activities": [
			{
				"name": "Check SQLPool Status",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://',pipeline().DataFactory,'.dev.azuresynapse.net/sqlPools/',pipeline().parameters.database_name,'?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			},
			{
				"name": "If SQL Pool is Online",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check SQLPool Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Check SQLPool Status').output.properties.status, 'Online')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set schedule key",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "schedule_key",
								"value": {
									"value": "@substring(pipeline().parameters.trigger_name, 10, sub(length(pipeline().parameters.trigger_name), 21))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Get gatherstats details",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Set schedule key",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:20:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "synw-spf-0091-dev-mgmt-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.database_name",
										"type": "Expression"
									}
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "SELECT *\nFROM [mgmt_xtinfra].[infra_gatherstats_schedule_detail]\nWHERE [infra_schedule_key] = '@{variables('schedule_key')}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "00:20:00"
							}
						},
						{
							"name": "infra_gatherstats",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Get gatherstats details",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.5:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[mgmt_xtinfra].[sp_infra_gatherstats]",
								"storedProcedureParameters": {
									"stats_type": {
										"value": {
											"value": "@activity('Get gatherstats details').output.resultSets[0].rows[0].stats_type",
											"type": "Expression"
										},
										"type": "String"
									},
									"stats_pct": {
										"value": {
											"value": "@activity('Get gatherstats details').output.resultSets[0].rows[0].stats_pct",
											"type": "Expression"
										},
										"type": "Int16"
									},
									"schema_name": {
										"value": {
											"value": "@activity('Get gatherstats details').output.resultSets[0].rows[0].schema_name",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "synw-spf-0091-dev-mgmt-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@pipeline().parameters.database_name",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"database_name": {
				"type": "string",
				"defaultValue": "dpspf009101"
			},
			"trigger_name": {
				"type": "string"
			}
		},
		"variables": {
			"schedule_key": {
				"type": "String"
			}
		},
		"annotations": []
	}
}