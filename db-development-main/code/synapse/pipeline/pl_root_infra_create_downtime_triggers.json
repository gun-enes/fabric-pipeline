{
	"name": "pl_root_infra_create_downtime_triggers",
	"properties": {
		"activities": [
			{
				"name": "Delete Trigger File",
				"type": "Delete",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "trigger_dataset",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@pipeline().parameters.folder_path",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": false,
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "Wait for sql pool",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Delete Trigger File",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_check_sql_pool_status",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"workspace_name": {
							"value": "@pipeline().DataFactory",
							"type": "Expression"
						},
						"sqlPool_name": {
							"value": "@pipeline().parameters.database_name",
							"type": "Expression"
						},
						"expected_state": {
							"value": "online",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "If Pool is Online",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Wait for sql pool",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(toLower(activity('Wait for sql pool').output.pipelineReturnValue.pool_status), 'online')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute Process Schedules",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_process_schedules",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"database_name": {
										"value": "@pipeline().parameters.database_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute Create JSON Schedules Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute Process Schedules",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_infra_create_json_schedules",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"database_name": {
										"value": "@pipeline().parameters.database_name",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"database_name": {
				"type": "string",
				"defaultValue": "dpspf009101"
			},
			"folder_path": {
				"type": "string"
			},
			"file_name": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-08-13T14:42:35Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}
