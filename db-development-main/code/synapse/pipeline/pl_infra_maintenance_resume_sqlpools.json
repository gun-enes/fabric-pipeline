{
	"name": "pl_infra_maintenance_resume_sqlpools",
	"properties": {
		"description": "this pipeline will start-stop triggers in workspace during maintenance",
		"activities": [
			{
				"name": "ForEach sqlpool in response",
				"description": "Iterates over list of sqlpool response",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read SQLPools StateFile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read SQLPools StateFile').output.value",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "If Status Online",
							"description": "checks if the status is online or not",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@or(equals(item().properties.status,'Online' ), equals(item().name, pipeline().parameters.database_name))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "resume sql pool",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_control_sql_pool",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"workspace_name": {
													"value": "@split(item().id,'/')[8]",
													"type": "Expression"
												},
												"sqlPool_name": {
													"value": "@item().name",
													"type": "Expression"
												},
												"resourceGroup": {
													"value": "@split(item().id,'/')[4]",
													"type": "Expression"
												},
												"subscriptionId": {
													"value": "@split(item().id,'/')[2]",
													"type": "Expression"
												},
												"target_state": "online"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Read SQLPools StateFile",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "sqlPoolsStatefile",
						"type": "DatasetReference",
						"parameters": {
							"workspace_name": {
								"value": "@pipeline().parameters.workspace_name",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"workspace_name": {
				"type": "string",
				"defaultValue": "synw-spf-0091-dev-mgmt"
			},
			"storage_account": {
				"type": "string",
				"defaultValue": "stspf0091devwks"
			},
			"database_name": {
				"type": "string",
				"defaultValue": "dpspf009101"
			}
		},
		"folder": {
			"name": "Maintenance_End_Activities"
		},
		"annotations": [],
		"lastPublishTime": "2025-04-14T10:12:02Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}