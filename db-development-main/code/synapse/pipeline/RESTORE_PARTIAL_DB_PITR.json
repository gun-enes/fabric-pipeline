										},
										"cw_table": {
											"value": "@item().TABLE_NAME",
											"type": "Expression"
										},
										"WorkspaceName": {
											"value": "@pipeline().parameters.WorkspaceName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DR_BACKUP_LINK",
									"type": "DatasetReference",
									"parameters": {
										"dbName": {
											"value": "@pipeline().parameters.TargetDB",
											"type": "Expression"
										},
										"cw_schema": "@item().TABLE_SCHEMA",
										"cw_table": "@item().TAB_RENAME",
										"WorkspaceName": {
											"value": "@pipeline().parameters.WorkspaceName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "SQL Procedure Partial Restore",
