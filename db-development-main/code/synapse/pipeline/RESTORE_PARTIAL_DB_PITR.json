						"restore_type": {
							"value": {
								"value": "@pipeline().parameters.RestoreType",
								"type": "Expression"
							},
							"type": "String"
						},
						"schema_name": {
							"value": {
								"value": "@pipeline().parameters.SchemaName",
								"type": "Expression"
							},
							"type": "String"
						},
						"table_name": {
							"value": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DedicatedForBackup",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": {
							"value": "@pipeline().parameters.SourceDB",
							"type": "Expression"
						},
						"WorkspaceName": {
							"value": "@pipeline().parameters.WorkspaceName",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"WorkspaceName": {
				"type": "string"
			},
			"SourceDB": {
				"type": "string"
			},
			"TargetDB": {
				"type": "string"
			},
			"RestoreType": {
				"type": "string"
			},
			"SchemaName": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			},
			"RestoreName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}