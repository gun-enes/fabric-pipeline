{
	"name": "pl_initialize_variables",
	"properties": {
		"activities": [
			{
				"name": "activity-get-all-mpes-workspace",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:40:00",
					"retry": 3,
					"retryIntervalInSeconds": 600,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://',pipeline().DataFactory,'.dev.azuresynapse.net/managedVirtualNetworks/default/managedPrivateEndpoints?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"properties": {
							"runtimeState": "Stopped"
						}
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			},
			{
				"name": "activity-get-primary-storage-account-linked-service",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set MPE List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://',pipeline().DataFactory,'.dev.azuresynapse.net/linkedservices/',pipeline().DataFactory,'-WorkspaceDefaultStorage?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			},
			{
				"name": "activity-get-function-app-mpe",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Filter Synapse MPEs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://',pipeline().DataFactory,'.dev.azuresynapse.net/managedVirtualNetworks/default/managedPrivateEndpoints/MaintenanceFunction?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			},
			{
				"name": "Set Variables",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "activity-get-function-app-mpe",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "storage_account",
							"value": {
								"type": "Expression",
								"content": "@split(split(activity('activity-get-primary-storage-account-linked-service').output.properties.typeProperties.url, '://')[1], '.')[0]"
							}
						},
						{
							"key": "function_app_name",
							"value": {
								"type": "Expression",
								"content": "@split(activity('activity-get-function-app-mpe').output.properties.privateLinkResourceId,'/')[8]"
							}
						},
						{
							"key": "subscription",
							"value": {
								"type": "Expression",
								"content": "@split(activity('activity-get-function-app-mpe').output.id, '/')[2]"
							}
						},
						{
							"key": "synapse_mpe_list",
							"value": {
								"type": "Expression",
								"content": "@activity('Filter Synapse MPEs').output.value"
							}
						},
						{
							"key": "external_storage_account",
							"value": {
								"type": "Expression",
								"content": "@split(split(activity('activity-get-external-storage-account').output.properties.typeProperties.url, '://')[1], '.')[0]"
							}
						}
					],
					"setSystemVariable": true
				}
			},
			{
				"name": "Set MPE List",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "activity-get-all-mpes-workspace",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "mpe_list",
					"value": {
						"value": "@activity('activity-get-all-mpes-workspace').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Filter Synapse MPEs",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "activity-get-external-storage-account",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('mpe_list')",
						"type": "Expression"
					},
					"condition": {
						"value": "@startswith(item().name,'SynapseDev')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "activity-get-external-storage-account",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "activity-get-primary-storage-account-linked-service",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://',pipeline().DataFactory,'.dev.azuresynapse.net/linkedservices/','DataLakeExternal?api-version=2020-12-01')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "VNetEnabledIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://dev.azuresynapse.net/"
					}
				}
			}
		],
		"variables": {
			"mpe_list": {
				"type": "Array"
			},
			"trigger_list": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-07-29T10:40:40Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}