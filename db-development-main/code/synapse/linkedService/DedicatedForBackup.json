{
	"name": "DedicatedForBackup",
	"properties": {
		"parameters": {
			"DBName": {
				"type": "string"
			},
			"WorkspaceName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureSqlDW",
		"typeProperties": {
			"connectionString": "Integrated Security=False;Encrypt=True;Connection Timeout=300;Data Source=\"@{concat('tcp:',linkedService().WorkspaceName,'.sql.azuresynapse.net,1433')}\";Initial Catalog=@{linkedService().DBName}"
		},
		"connectVia": {
			"referenceName": "VNetEnabledIntegrationRuntime",
			"type": "IntegrationRuntimeReference"
		}
	}
}