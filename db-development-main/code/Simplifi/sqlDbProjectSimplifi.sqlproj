<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.0.0" />
  <PropertyGroup>
    <Name>sqlDbProjectSimplifi</Name>
    <ProjectGuid>{613E988E-572D-44FB-97B1-25E15F299675}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlDwDatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>LATIN1_GENERAL_100_CI_AS_SC_UTF8</DefaultCollation>
  </PropertyGroup>
  <PropertyGroup>
    <SuppressTSqlWarnings>71502,71509</SuppressTSqlWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Synapse.Master">
      <Version>130.2.2</Version>
      <GeneratePathProperty>True</GeneratePathProperty>
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\sql\sqlDbProject.sqlproj">
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="StoredProcedures" />
    <Folder Include="Tables" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="Script.SpfPostDeployment1.sql" />
    <None Include="Script.SpfPostDeployment_DefaultSchedules.sql" />
    <None Include="Script.SpfPostDeployment_ConfigTables.sql" />
    <None Include="Script.SpfPostDeployment_CreateStaticSchemas.sql" />
    <None Include="Script.SpfPostDeployment_CoreUserRoleAssignments.sql" />
    <None Include="Script.SpfPostDeployment_ExtUserRoleAssignments.sql" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
  <PropertyGroup>
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
</Project>
