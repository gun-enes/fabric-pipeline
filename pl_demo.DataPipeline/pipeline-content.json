{
  "properties": {
    "activities": [
      {
        "name": "Set Greeting Output",
        "type": "SetVariable",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "result",
          "value": {
            "value": "@concat('Message: ', pipeline().parameters.greeting)",
            "type": "Expression"
          }
        }
      }
    ],
    "parameters": {
      "greeting": {
        "type": "string",
        "defaultValue": "hello from prod2"
      }
    },
    "variables": {
      "result": {
        "type": "String"
      }
    }
  }
}